{
	"extends": "@ramz001-cinema/core/tsconfig/nest",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./",
		"baseUrl": "./",
		"paths": {
			"@/*": [
				"src/*"
			],
			"@prisma/generated": [
				"prisma/generated"
			],
			"@prisma/generated/*": [
				"prisma/generated/*"
			]
		}
	},
	"exclude": [
		"node_modules",
		"dist",
		"test"
	]
}