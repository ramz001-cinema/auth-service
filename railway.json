{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK",
		"buildCommand": "pnpm build"
	},
	"deploy": {
		"startCommand": "node dist/src/main.js",
		"preDeployCommand": "npx prisma migrate deploy",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5
	}
}
